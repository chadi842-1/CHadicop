# Donnees volumineuses et regenerables (via `make generate` / `make datamart`)
data/raw/
data/mart/

# Les exports (KPI, process mining, scoring, qualite) sont versionnes : ce sont
# les "resultats" consultables, et ils alimentent les specs BI et le dashboard.
!data/exports/

# Modeles entraines : binaires regenerables -> ignores.
# La carte de modele (JSON, lisible) est conservee.
models/*.joblib

# Table de faits Power BI : volumineuse et regenerable
# (python -m fibre360.reporting.powerbi_export). Les dimensions, legeres,
# sont versionnees pour que le modele soit lisible dans le depot.
powerbi/dataset/fact_parcours.csv

